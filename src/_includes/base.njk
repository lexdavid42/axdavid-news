<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set pageTitle = (title + " | " + site.title) if title else (site.title + " — " + site.tagline) %}
{% set pageDesc = description or site.description %}
{% set pageImage = (image | absUrl(site.url)) if image else ("/assets/icon-512.png" | absUrl(site.url)) %}
{% set pageUrl = page.url | absUrl(site.url) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ pageUrl }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ pageImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.title }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ pageImage }}">
<meta name="theme-color" content="#FFFFFF">
<link rel="icon" type="image/png" href="/assets/favicon.png">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
<style>
:root{--g:#16A34A;--g-soft:#E8F6EE;--y:#FFC832;--ink:#1D1D1F;--muted:#6E6E73;--line:#E5E5EA;--bg:#FFFFFF;--bg2:#F5F5F7}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.6 -apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Inter,Roboto,Helvetica,Arial,sans-serif;-webkit-font-smoothing:antialiased}
a{color:inherit}
.wrap{max-width:1080px;margin:0 auto;padding:0 16px}
header.top{position:sticky;top:0;z-index:10;background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--line)}
header.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:60px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
.brand img{height:34px;width:auto;border-radius:7px;display:block}
.brand span{font-weight:600;font-size:15px;letter-spacing:-.01em}
.brand span b{color:var(--g);font-weight:600}
nav.top a{color:#fff;background:var(--g);text-decoration:none;font-weight:500;font-size:14px;padding:7px 16px;border-radius:999px;white-space:nowrap}
nav.top a:hover{filter:brightness(1.08)}
.hero{padding:72px 0 24px;text-align:center}
.hero h1{font-size:clamp(34px,6vw,56px);line-height:1.07;margin:0 0 12px;letter-spacing:-.025em;font-weight:700}
.hero h1 mark{background:none;color:var(--g);padding:0}
.hero p{margin:0 auto;color:var(--muted);font-size:clamp(17px,2.4vw,21px);max-width:620px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px;padding:32px 0 72px}
.card{background:var(--bg2);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;text-decoration:none;transition:transform .2s,box-shadow .2s}
.card:hover{transform:scale(1.015);box-shadow:0 12px 32px rgba(0,0,0,.08)}
.card img{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;display:block;background:var(--g-soft)}
.card .ph{aspect-ratio:16/9;background:var(--g-soft)}
.card .body{padding:18px 20px 22px}
.card time{font-size:12px;color:var(--g);font-weight:600;text-transform:uppercase;letter-spacing:.06em}
.card h2{font-size:21px;line-height:1.25;margin:6px 0 8px;letter-spacing:-.015em}
.card p{margin:0;color:var(--muted);font-size:15px}
article.post{max-width:700px;margin:0 auto;padding:48px 0 72px}
article.post .meta{font-size:12px;color:var(--g);font-weight:600;text-transform:uppercase;letter-spacing:.06em}
article.post h1{font-size:clamp(30px,5vw,44px);line-height:1.1;margin:10px 0 24px;letter-spacing:-.025em}
article.post .cover{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:18px;display:block;margin-bottom:28px;background:var(--g-soft)}
article.post .content p{margin:0 0 18px}
article.post .content ul{padding-left:22px;margin:0 0 18px}
article.post .content li{margin-bottom:8px}
article.post .content li::marker{color:var(--g)}
article.post .content strong{color:var(--g)}
article.post .content a{color:var(--g);text-underline-offset:3px}
.cta{margin-top:40px;background:var(--g-soft);border-radius:18px;padding:24px;display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between}
.cta p{margin:0;font-weight:600;font-size:18px;letter-spacing:-.01em}
.cta a{background:var(--g);color:#fff;text-decoration:none;font-weight:500;padding:10px 20px;border-radius:999px;white-space:nowrap}
.back{display:inline-block;margin-top:24px;font-weight:500;color:var(--g);text-decoration:none}
footer{background:var(--bg2);border-top:1px solid var(--line);padding:24px 0 40px;color:var(--muted);font-size:13px}
footer .wrap{display:flex;flex-wrap:wrap;gap:12px 24px;justify-content:space-between}
footer a{text-decoration:none}
footer a:hover{color:var(--g)}
.empty{padding:24px 0 96px;color:var(--muted);text-align:center}
@media (max-width:480px){.brand span{display:none}body{font-size:16px}.hero{padding:48px 0 16px}}
</style>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/"><img src="/assets/logo-badge.png" alt="AXDAVID AI" width="66" height="40"><span>AI <b>News</b></span></a>
    <nav class="top"><a href="{{ site.mainSite }}">axdavid.com</a></nav>
  </div>
</header>
<main class="wrap">
{{ content | safe }}
</main>
<footer>
  <div class="wrap">
    <span>&copy; AXDAVID Artificial Intelligence LLC</span>
    <span><a href="{{ site.mainSite }}">axdavid.com</a> &nbsp;·&nbsp; <a href="{{ site.facebook }}">Facebook</a> &nbsp;·&nbsp; <a href="{{ site.linkedin }}">LinkedIn</a> &nbsp;·&nbsp; <a href="/feed.xml">RSS</a></span>
  </div>
</footer>
</body>
</html>
